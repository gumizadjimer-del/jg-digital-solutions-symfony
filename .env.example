APP_ENV=dev
APP_SECRET=replace-with-a-random-local-secret
APP_SHARE_DIR=var/share

MYSQL_ROOT_PASSWORD=replace-with-a-strong-local-root-password
MYSQL_DATABASE=jg_symfony
MYSQL_USER=symfony
MYSQL_PASSWORD=replace-with-a-strong-local-database-password

DEFAULT_URI=http://localhost:8000
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@database:3306/${MYSQL_DATABASE}?serverVersion=8.4.0&charset=utf8mb4"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
