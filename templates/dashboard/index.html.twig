<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard | JG Digital Solutions</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background: #000000;
            color: #ffffff;
        }

        header {
            background: #231F20;
            padding: 20px 40px;
            border-bottom: 3px solid #FAAF43;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            color: #FAAF43;
            margin: 0;
        }

        header a {
            color: #ffffff;
            text-decoration: none;
            margin-left: 20px;
        }

        header a:hover {
            color: #FAAF43;
        }

        main {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .welcome {
            margin-bottom: 30px;
        }

        .welcome h2 {
            margin-bottom: 5px;
        }

        .request-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .new-request {
            background: #FAAF43;
            color: #000000;
            padding: 12px 18px;
            text-decoration: none;
            font-weight: bold;
            border-radius: 4px;
        }

        .new-request:hover {
            background: #ffffff;
        }

        .request {
            background: #231F20;
            border: 1px solid #444444;
            padding: 20px;
            margin-bottom: 15px;
            border-radius: 5px;
        }

        .request h3 {
            color: #FAAF43;
            margin-top: 0;
        }

        .status {
            font-weight: bold;
        }

        .note {
            margin-top: 15px;
            padding: 12px;
            background: #000000;
            border-left: 3px solid #FAAF43;
        }

        .empty {
            background: #231F20;
            padding: 25px;
            text-align: center;
        }

        .request-summary {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 12px;
            margin: 0 0 28px;
        }

        .request-stat {
            background: #231F20;
            border: 1px solid #444444;
            border-top: 3px solid #FAAF43;
            border-radius: 5px;
            padding: 14px;
        }

        .request-stat span,
        .request-stat strong {
            display: block;
        }

        .request-stat span { color: #dddddd; font-size: 0.9rem; }
        .request-stat strong { color: #FAAF43; font-size: 1.5rem; margin-top: 6px; }

        .request-filter-form {
            display: grid;
            grid-template-columns: minmax(220px, 1fr) minmax(160px, 0.5fr) auto auto;
            align-items: end;
            gap: 14px;
            margin-bottom: 12px;
        }

        .request-filter-form label { display: block; margin-bottom: 6px; }
        .request-filter-form input,
        .request-filter-form select { width: 100%; box-sizing: border-box; padding: 10px; }
        .request-filter-form button,
        .request-filter-form a { padding: 11px 15px; border: 0; border-radius: 4px; font: inherit; font-weight: bold; }
        .request-filter-form button { background: #FAAF43; color: #000000; cursor: pointer; }
        .request-filter-form a { background: #444444; color: #FFFFFF; text-decoration: none; }

        .request-pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 16px;
            margin: 24px 0;
        }

        .request-pagination a { color: #FAAF43; }

        @media (max-width: 700px) {
            header { padding: 18px 20px; align-items: flex-start; gap: 14px; flex-direction: column; }
            header nav { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
            header a { margin-left: 0; }
            .request-header { align-items: flex-start; flex-direction: column; gap: 12px; }
            .request-filter-form { grid-template-columns: 1fr; }
        }
    .logout-link { background: transparent; border: 0; color: #FFFFFF; font: inherit; cursor: pointer; }
        .logout-link:hover { color: #FAAF43; }
    </style>
</head>

<body>

<header>
    <h1>JG Digital Solutions</h1>

    <nav>
        <a href="{{ path('app_dashboard') }}">Dashboard</a>
        <a href="{{ path('app_profile') }}">My Profile</a>
        <a href="{{ path('app_password_change') }}">Change Password</a>
        <form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="logout-link" type="submit">Logout</button></form>
    </nav>
</header>

<main>

    <section class="welcome">
        <h2>Welcome, {{ app.user.username }}!</h2>
        <p>View the status of your service requests below.</p>
    </section>

    <section class="request-summary" aria-label="Service request totals">
        {% for status, count in requestStatusCounts %}
            <div class="request-stat"><span>{{ status }}</span><strong>{{ count }}</strong></div>
        {% endfor %}
        <div class="request-stat"><span>All Requests</span><strong>{{ allRequestCount }}</strong></div>
    </section>

    {% for message in app.flashes('success') %}<div class="form-success">{{ message }}</div>{% endfor %}

    <section>
        <div class="request-header">
            <h2>My Service Requests</h2>

            <a class="new-request" href="{{ path('app_service_request_new') }}">
                + New Service Request
            </a>
        </div>

        <form class="request-filter-form" method="get" action="{{ path('app_dashboard') }}">
            <div>
                <label for="q">Search service or description</label>
                <input id="q" name="q" type="search" maxlength="100" value="{{ search }}">
            </div>
            <div>
                <label for="status">Status</label>
                <select id="status" name="status">
                    <option value="">All statuses</option>
                    {% for status in statuses %}
                        <option value="{{ status }}" {{ selectedStatus == status ? 'selected' : '' }}>{{ status }}</option>
                    {% endfor %}
                </select>
            </div>
            <button type="submit">SEARCH</button>
            <a href="{{ path('app_dashboard') }}">CLEAR</a>
        </form>
        <p><a class="new-request" href="{{ path('app_dashboard_export', {q: search, status: selectedStatus}) }}">DOWNLOAD MY FILTERED CSV</a></p>
        <p class="form-hint">Showing {{ firstResult }} to {{ lastResult }} of {{ totalRequests }} matching requests.</p>

        {% if serviceRequests is empty %}

            <div class="empty">
                <p>No service requests match these filters.</p>
                <a class="new-request" href="{{ path('app_service_request_new') }}">Create a service request</a>
            </div>

        {% else %}

            {% for request in serviceRequests %}

                <div class="request">

                    <h3>{{ request.service }}</h3>

                    <p>
                        <strong>Description:</strong>
                        {{ request.description }}
                    </p>

                    <p>
                        <strong>Status:</strong>
                        <span class="status">{{ request.status }}</span>
                    </p>

                    <p>
                        <strong>Date:</strong>
                        {{ request.createdAt|date('F d, Y') }}
                    </p>

                    <p><a href="{{ path('app_service_request_show', {id: request.id}) }}">View request details</a></p>
                    {% if request.adminNote %}
                        <div class="note">
                            <strong>Admin Note:</strong>
                            <p>{{ request.adminNote }}</p>
                        </div>
                    {% endif %}

                </div>

            {% endfor %}

        {% endif %}

        {% if totalPages > 1 %}
            <nav class="request-pagination" aria-label="Service request pages">
                {% if page > 1 %}
                    <a href="{{ path('app_dashboard', {q: search, status: selectedStatus, page: page - 1}) }}">Previous</a>
                {% endif %}
                <span>Page {{ page }} of {{ totalPages }}</span>
                {% if page < totalPages %}
                    <a href="{{ path('app_dashboard', {q: search, status: selectedStatus, page: page + 1}) }}">Next</a>
                {% endif %}
            </nav>
        {% endif %}

    </section>

</main>

</body>
</html>
