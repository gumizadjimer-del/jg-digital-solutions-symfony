<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile | JG Digital Solutions</title>
    <link rel="stylesheet" href="{{ asset('CSS/styleA.css') }}">
</head>
<body class="admin-page">
<header class="admin-header">
    <div class="admin-header-content">
        <strong class="admin-logo">JG Digital Solutions</strong>
        <nav class="admin-nav">
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin_dashboard') }}">Admin Dashboard</a>
            {% elseif is_granted('ROLE_STAFF') %}
                <a href="{{ path('app_staff_dashboard') }}">Staff Dashboard</a>
            {% else %}
                <a href="{{ path('app_dashboard') }}">Dashboard</a>
            {% endif %}
            <a href="{{ path('app_profile') }}">My Profile</a>
            <a href="{{ path('app_password_change') }}">Change Password</a>
            <form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="logout-link" type="submit">Logout</button></form>
        </nav>
    </div>
</header>
<main class="admin-container">
    <div class="admin-heading"><h1>My Profile</h1><p>Update your account details. Your role is managed by an administrator.</p></div>

    {% for message in app.flashes('success') %}<div class="form-success" role="status">{{ message }}</div>{% endfor %}
    {% for error in errors %}<div class="form-error" role="alert">{{ error }}</div>{% endfor %}

    <section class="request-card">
        <p><strong>Role:</strong> {{ user.role|capitalize }}</p>
        <p><strong>Account status:</strong> {{ user.isActive ? 'Active' : 'Disabled' }}</p>
        <p><strong>Created:</strong> {{ user.createdAt|date('Y-m-d') }}</p>
        <form method="post" action="{{ path('app_profile') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('update_profile') }}">
            <div class="form-group">
                <label for="username">Username</label>
                <input id="username" name="username" type="text" minlength="3" maxlength="50" value="{{ formData.username }}" required>
            </div>
            <div class="form-group">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" maxlength="150" value="{{ formData.email }}" required>
            </div>
            <button class="auth-button" type="submit">SAVE PROFILE</button>
        </form>
    </section>
</main>
</body>
</html>
