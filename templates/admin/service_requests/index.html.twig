<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Service Requests</title><link rel="stylesheet" href="{{ asset('CSS/styleA.css') }}"></head><body class="admin-page"><header class="admin-header"><div class="admin-header-content"><strong class="admin-logo">JG Digital Solutions</strong><nav class="admin-nav"><a href="{{ path('app_admin_dashboard') }}">Dashboard</a><a href="{{ path('app_admin_users') }}">Users</a><a href="{{ path('app_admin_records') }}">Records</a><a href="{{ path('app_admin_service_requests') }}">Service Requests</a><a href="{{ path('app_admin_messages') }}">Messages</a><a href="{{ path('app_profile') }}">My Profile</a><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="logout-link" type="submit">Logout</button></form></nav></div></header>
<main class="admin-container"><div class="admin-heading"><h1>Service Requests</h1></div><div class="table-container"><table class="admin-table"><thead><tr><th>ID</th><th>User</th><th>Service</th><th>Status</th><th>Submitted</th><th></th></tr></thead><tbody>{% for request in requests %}<tr><td>{{ request.id }}</td><td>{{ request.user.username }}</td><td>{{ request.service }}</td><td>{{ request.status }}</td><td>{{ request.createdAt|date('Y-m-d H:i') }}</td><td><a class="edit-button" href="{{ path('app_admin_service_request_show', {id: request.id}) }}">VIEW / EDIT</a></td></tr>{% else %}<tr><td colspan="6">No requests.</td></tr>{% endfor %}</tbody></table></div></main></body></html>