<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Service Requests | JG Digital Solutions</title>
    <link rel="stylesheet" href="{{ asset('CSS/styleA.css') }}">
</head>
<body class="admin-page">
<header class="admin-header">
    <div class="admin-header-content">
        <a class="admin-logo" href="{{ path('app_home') }}" aria-label="JG Digital Solutions home"><img src="{{ asset('image/Asset 1.png') }}" alt="JG Digital Solutions"></a>
        <nav class="admin-nav">
            <a href="{{ path('app_admin_dashboard') }}">Dashboard</a>
            <a href="{{ path('app_admin_users') }}">Users</a>
            <a href="{{ path('app_admin_records') }}">Records</a>
            <a href="{{ path('app_admin_service_requests') }}">Service Requests</a>
            <a href="{{ path('app_admin_messages') }}">Messages</a>
            <a href="{{ path('app_profile') }}">My Profile</a>
            <form method="post" action="{{ path('app_logout') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button class="logout-link" type="submit">Logout</button>
            </form>
        </nav>
    </div>
</header>
<main class="admin-container">
    <div class="admin-heading">
        <h1>Service Requests</h1>
        <p>Search requests by service, description, or customer; filter by status.</p>
    </div>
    {% for message in app.flashes('success') %}<div class="form-success" role="status">{{ message }}</div>{% endfor %}
    <form class="record-filter-form" method="get" action="{{ path('app_admin_service_requests') }}">
        <div class="form-group">
            <label for="q">Search service, description, or customer</label>
            <input id="q" name="q" type="search" maxlength="100" value="{{ search }}">
        </div>
        <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status">
                <option value="">All statuses</option>
                {% for status in statuses %}
                    <option value="{{ status }}" {{ selectedStatus == status ? 'selected' : '' }}>{{ status }}</option>
                {% endfor %}
            </select>
        </div>
        <button class="auth-button" type="submit">SEARCH</button>
        <a class="back-button" href="{{ path('app_admin_service_requests') }}">CLEAR</a>
    </form>
    <p><a class="dashboard-button" href="{{ path('app_admin_service_requests_export', {q: search, status: selectedStatus}) }}">DOWNLOAD FILTERED CSV</a></p>
    <p class="form-hint">Showing {{ firstResult }} to {{ lastResult }} of {{ totalRequests }} requests.</p>
    <div class="table-container">
        <table class="admin-table">
            <thead>
                <tr><th>ID</th><th>User</th><th>Service</th><th>Status</th><th>Submitted</th><th></th></tr>
            </thead>
            <tbody>
            {% for request in requests %}
                <tr>
                    <td>{{ request.id }}</td>
                    <td>{{ request.user.username }}</td>
                    <td>{{ request.service }}</td>
                    <td>{{ request.status }}</td>
                    <td>{{ request.createdAt|date('Y-m-d H:i') }}</td>
                    <td><a class="edit-button" href="{{ path('app_admin_service_request_show', {id: request.id}) }}">VIEW / EDIT</a></td>
                </tr>
            {% else %}
                <tr><td colspan="6">No requests matched your search.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% if totalPages > 1 %}
        <nav class="pagination" aria-label="Service request pages">
            {% if page > 1 %}
                <a href="{{ path('app_admin_service_requests', {q: search, status: selectedStatus, page: page - 1}) }}">Previous</a>
            {% endif %}
            <span>Page {{ page }} of {{ totalPages }}</span>
            {% if page < totalPages %}
                <a href="{{ path('app_admin_service_requests', {q: search, status: selectedStatus, page: page + 1}) }}">Next</a>
            {% endif %}
        </nav>
    {% endif %}
</main>
</body>
</html>
