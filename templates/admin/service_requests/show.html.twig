<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Manage Request</title><link rel="stylesheet" href="{{ asset('CSS/styleA.css') }}"></head><body class="admin-page"><header class="admin-header"><div class="admin-header-content"><strong class="admin-logo">JG Digital Solutions</strong><nav class="admin-nav"><a href="{{ path('app_admin_dashboard') }}">Dashboard</a><a href="{{ path('app_admin_users') }}">Users</a><a href="{{ path('app_admin_records') }}">Records</a><a href="{{ path('app_admin_service_requests') }}">Service Requests</a><a href="{{ path('app_admin_messages') }}">Messages</a><a href="{{ path('app_profile') }}">My Profile</a><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="logout-link" type="submit">Logout</button></form></nav></div></header>
<main class="admin-container"><h1>Request #{{ serviceRequest.id }}</h1><p>From {{ serviceRequest.user.username }} | {{ serviceRequest.user.email }} | {{ serviceRequest.createdAt|date('Y-m-d H:i') }}</p>{% for message in app.flashes('success') %}<div class="form-success">{{ message }}</div>{% endfor %}{% if error %}<div class="form-error">{{ error }}</div>{% endif %}<section class="request-card"><h2>{{ serviceRequest.service }}</h2><p>{{ serviceRequest.description }}</p><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('manage_request_' ~ serviceRequest.id) }}"><div class="form-group"><label for="status">Status</label><select id="status" name="status">{% if legacyStatus %}<option value="{{ serviceRequest.status }}" selected>{{ serviceRequest.status }} (existing status)</option>{% endif %}{% for status in statuses %}<option value="{{ status }}" {{ status == serviceRequest.status ? 'selected' : '' }}>{{ status }}</option>{% endfor %}</select></div><div class="form-group"><label for="admin_note">Admin note (shown to the user)</label><textarea id="admin_note" name="admin_note" maxlength="5000">{{ serviceRequest.adminNote }}</textarea></div><button class="auth-button">Save changes</button></form></section><a class="back-button" href="{{ path('app_admin_service_requests') }}">Back to requests</a></main></body></html>