<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Work Records | JG Digital Solutions</title>
    <link rel="stylesheet" href="{{ asset('CSS/styleA.css') }}">
</head>
<body class="admin-page">
<header class="admin-header"><div class="admin-header-content">
    <strong class="admin-logo">JG Digital Solutions</strong>
    <nav class="admin-nav">
        <a href="{{ path('app_admin_dashboard') }}">Dashboard</a>
        <a href="{{ path('app_admin_users') }}">Users</a>
        <a href="{{ path('app_admin_records') }}">Records</a>
        <a href="{{ path('app_admin_messages') }}">Messages</a>
        <a href="{{ path('app_admin_service_requests') }}">Service Requests</a>
        <a href="{{ path('app_profile') }}">My Profile</a>
        <form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="logout-link" type="submit">Logout</button></form>
    </nav>
</div></header>
<main class="admin-container">
    <div class="admin-heading"><h1>Staff Work Records</h1><p>Search, filter, and manage work records created by Staff.</p><a class="auth-button" href="{{ path('app_admin_record_new') }}">CREATE RECORD</a></div>
    {% for message in app.flashes('success') %}<div class="form-success" role="status">{{ message }}</div>{% endfor %}
    <form class="record-filter-form" method="get" action="{{ path('app_admin_records') }}">
        <div class="form-group"><label for="q">Search title, description, or creator</label><input id="q" name="q" type="search" maxlength="100" value="{{ search }}"></div>
        <div class="form-group"><label for="status">Status</label><select id="status" name="status"><option value="">All statuses</option>{% for status in statuses %}<option value="{{ status }}" {{ selectedStatus == status ? 'selected' : '' }}>{{ status }}</option>{% endfor %}</select></div>
        <button class="auth-button" type="submit">SEARCH</button>
        <a class="back-button" href="{{ path('app_admin_records') }}">CLEAR</a>
    </form>
    <p class="form-hint">Showing {{ pageResults }} of {{ totalRecords }} matching records.</p>
    <div class="table-container"><table class="admin-table">
        <thead><tr><th>Title</th><th>Description</th><th>Created by</th><th>Status</th><th>Created</th><th>Updated</th><th>Actions</th></tr></thead>
        <tbody>
        {% for record in records %}
            <tr>
                <td>{{ record.title }}</td><td>{{ record.description|slice(0, 100) }}{% if record.description|length > 100 %}...{% endif %}</td>
                <td>{{ record.createdBy.username }} ({{ record.createdBy.role }})</td><td>{{ record.status }}</td>
                <td>{{ record.createdAt|date('Y-m-d') }}</td><td>{{ record.updatedAt|date('Y-m-d H:i') }}</td>
                <td class="action-buttons">
                    <a class="edit-button" href="{{ path('app_admin_record_edit', {id: record.id}) }}">EDIT</a>
                    <form method="post" action="{{ path('app_admin_record_delete', {id: record.id}) }}" onsubmit="return confirm('Delete this work record?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_admin_record_' ~ record.id) }}">
                        <button class="delete-button" type="submit">DELETE</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="7">No work records matched your search.</td></tr>
        {% endfor %}
        </tbody>
    </table></div>
    {% if totalPages > 1 %}
        <nav class="pagination" aria-label="Work record pages">
            {% if page > 1 %}
                <a href="{{ path('app_admin_records', {q: search, status: selectedStatus, page: page - 1}) }}">Previous</a>
            {% endif %}
            <span>Page {{ page }} of {{ totalPages }}</span>
            {% if page < totalPages %}
                <a href="{{ path('app_admin_records', {q: search, status: selectedStatus, page: page + 1}) }}">Next</a>
            {% endif %}
        </nav>
    {% endif %}
</main>
</body>
</html>
