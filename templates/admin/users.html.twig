
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Users | JG Digital Solutions</title>
    <link rel="stylesheet" href="{{ asset('CSS/styleA.css') }}">
</head>

<body class="admin-page">

<header class="admin-header">
    <div class="admin-header-content">

        <strong class="admin-logo">JG Digital Solutions</strong>

        <nav class="admin-nav">
            <a href="{{ path('app_admin_dashboard') }}">Dashboard</a>
            <a href="{{ path('app_admin_users') }}">Users</a>
            <a href="{{ path('app_admin_records') }}">Records</a>
            <a href="{{ path('app_admin_messages') }}">Messages</a>
            <a href="{{ path('app_admin_service_requests') }}">Service Requests</a>
            <a href="{{ path('app_profile') }}">My Profile</a>
            <form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="logout-link" type="submit">Logout</button></form>
        </nav>

    </div>
</header>

<main class="admin-container">

    <div class="admin-heading">
        <h1>Manage Users</h1>
        <p>View and manage registered users.</p>
        <a href="{{ path('app_admin_user_new') }}" class="auth-button">CREATE ACCOUNT</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="form-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="form-error">{{ message }}</div>
    {% endfor %}

    <form class="user-filter-form" method="get" action="{{ path('app_admin_users') }}">
        <div class="form-group">
            <label for="q">Search username or email</label>
            <input id="q" name="q" type="search" maxlength="100" value="{{ search }}">
        </div>
        <div class="form-group">
            <label for="role">Role</label>
            <select id="role" name="role">
                <option value="">All roles</option>
                <option value="user" {{ selectedRole == 'user' ? 'selected' : '' }}>User</option>
                <option value="staff" {{ selectedRole == 'staff' ? 'selected' : '' }}>Staff</option>
                <option value="admin" {{ selectedRole == 'admin' ? 'selected' : '' }}>Admin</option>
            </select>
        </div>
        <div class="form-group">
            <label for="status">Account status</label>
            <select id="status" name="status">
                <option value="">All statuses</option>
                <option value="active" {{ selectedStatus == 'active' ? 'selected' : '' }}>Active</option>
                <option value="disabled" {{ selectedStatus == 'disabled' ? 'selected' : '' }}>Disabled</option>
            </select>
        </div>
        <button class="auth-button" type="submit">SEARCH</button>
        <a class="back-button" href="{{ path('app_admin_users') }}">CLEAR</a>
    </form>

    <p class="form-hint">Showing {{ firstResult }} to {{ lastResult }} of {{ totalUsers }} accounts.</p>

    <div class="table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td>{{ user.username }}</td>
                        <td>{{ user.email }}</td>

                        <td>
                            <span class="role-badge {{ user.role == 'admin' ? 'role-admin' : (user.role == 'staff' ? 'role-staff' : 'role-user') }}">
                                {{ user.role }}
                            </span>
                        </td>

                        <td>{{ user.isActive ? 'Active' : 'Disabled' }}</td>

                        <td>
                            {{ user.createdAt|date('Y-m-d H:i:s') }}
                        </td>

                        <td class="action-buttons">

                            <a href="{{ path('app_admin_user_edit', {id: user.id}) }}"
                               class="edit-button">
                                EDIT
                            </a>

                            {% if user.id != app.user.id %}
                                <form method="POST"
                                      class="delete-form"
                                      action="{{ path('app_admin_user_delete', {id: user.id}) }}"
                                      onsubmit="return confirm('Are you sure you want to delete this user?');">

                                    <input type="hidden"
                                           name="_token"
                                           value="{{ csrf_token('delete_user_' ~ user.id) }}">

                                    <button type="submit" class="delete-button">
                                        DELETE
                                    </button>
                                </form>
                            {% endif %}

                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7">No users found.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if totalPages > 1 %}
        <nav class="pagination" aria-label="User list pages">
            {% if page > 1 %}
                <a href="{{ path('app_admin_users', {q: search, role: selectedRole, status: selectedStatus, page: page - 1}) }}">Previous</a>
            {% endif %}
            <span>Page {{ page }} of {{ totalPages }}</span>
            {% if page < totalPages %}
                <a href="{{ path('app_admin_users', {q: search, role: selectedRole, status: selectedStatus, page: page + 1}) }}">Next</a>
            {% endif %}
        </nav>
    {% endif %}

    <a href="{{ path('app_admin_dashboard') }}" class="back-button">
        Back to Dashboard
    </a>

</main>
</body>
</html>
