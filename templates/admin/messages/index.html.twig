<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Contact Messages</title><link rel="stylesheet" href="{{ asset('CSS/styleA.css') }}"></head><body class="admin-page"><header class="admin-header"><div class="admin-header-content"><strong class="admin-logo">JG Digital Solutions</strong><nav class="admin-nav"><a href="{{ path('app_admin_dashboard') }}">Dashboard</a><a href="{{ path('app_admin_users') }}">Users</a><a href="{{ path('app_admin_records') }}">Records</a><a href="{{ path('app_admin_service_requests') }}">Service Requests</a><a href="{{ path('app_admin_messages') }}">Messages</a><a href="{{ path('app_profile') }}">My Profile</a><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="logout-link" type="submit">Logout</button></form></nav></div></header>
<main class="admin-container"><h1>Contact Messages</h1>{% for message in app.flashes('success') %}<div class="form-success">{{ message }}</div>{% endfor %}<div class="table-container"><table class="admin-table"><thead><tr><th>From</th><th>Email</th><th>Received</th><th>Message</th><th></th></tr></thead><tbody>{% for item in messages %}<tr><td>{{ item.name }}</td><td>{{ item.email }}</td><td>{{ item.createdAt|date('Y-m-d H:i') }}</td><td>{{ item.message|slice(0, 100) }}</td><td><a class="edit-button" href="{{ path('app_admin_message_show', {id: item.id}) }}">VIEW</a></td></tr>{% else %}<tr><td colspan="5">No messages.</td></tr>{% endfor %}</tbody></table></div></main></body></html>