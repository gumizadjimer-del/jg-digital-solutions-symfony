<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>View Message</title><link rel="stylesheet" href="{{ asset('CSS/styleA.css') }}"></head><body class="admin-page"><header class="admin-header"><div class="admin-header-content"><strong class="admin-logo">JG Digital Solutions</strong><nav class="admin-nav"><a href="{{ path('app_admin_dashboard') }}">Dashboard</a><a href="{{ path('app_admin_users') }}">Users</a><a href="{{ path('app_admin_records') }}">Records</a><a href="{{ path('app_admin_service_requests') }}">Service Requests</a><a href="{{ path('app_admin_messages') }}">Messages</a><a href="{{ path('app_profile') }}">My Profile</a><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="logout-link" type="submit">Logout</button></form></nav></div></header>
<main class="admin-container"><h1>Message from {{ message.name }}</h1><p>{{ message.email }} | {{ message.createdAt|date('Y-m-d H:i') }}</p><section class="request-card"><p>{{ message.message }}</p><form method="post" action="{{ path('app_admin_message_delete', {id: message.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete_message_' ~ message.id) }}"><button class="delete-button" onclick="return confirm('Delete this message?')">Delete message</button></form></section><a class="back-button" href="{{ path('app_admin_messages') }}">Back to messages</a></main></body></html>