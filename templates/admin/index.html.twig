
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Dashboard | JG Digital Solutions</title>

    <link rel="stylesheet" href="{{ asset('CSS/styleA.css') }}">
</head>

<body class="dashboard-page">

    <header class="admin-header">

        <div class="admin-header-content">

            <a class="admin-logo" href="{{ path('app_home') }}" aria-label="JG Digital Solutions home"><img src="{{ asset('image/Asset 1.png') }}" alt="JG Digital Solutions"></a>

            <nav class="admin-nav">
                <a href="{{ path('app_admin_dashboard') }}">Dashboard</a>
                <a href="{{ path('app_admin_users') }}">Users</a>
                <a href="{{ path('app_admin_records') }}">Records</a>
                <a href="{{ path('app_admin_service_requests') }}">Service Requests</a>
                <a href="{{ path('app_admin_messages') }}">Messages</a>
                <a href="{{ path('app_profile') }}">My Profile</a>
                <form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="logout-link" type="submit">Logout</button></form>
            </nav>

        </div>

    </header>

    <main class="dashboard-container">

        <div class="dashboard-heading">

            <h1>Admin Dashboard</h1>

            <p>
                Welcome, {{ app.user.username }}.
            </p>

        </div>

        <div class="dashboard-cards">

            <div class="dashboard-card">

                <h2>Users</h2>

                <div class="dashboard-number">
                    {{ totalUsers }}
                </div>

                <p>Registered users</p>

                <a href="{{ path('app_admin_users') }}" class="dashboard-button">
                    MANAGE USERS
                </a>

            </div>

            <div class="dashboard-card">
                <h2>Staff</h2>
                <div class="dashboard-number">{{ totalStaff }}</div>
                <p>Staff accounts</p>
                <a href="{{ path('app_admin_users') }}" class="dashboard-button">MANAGE ACCOUNTS</a>
            </div>

            <div class="dashboard-card">
                <h2>Work Records</h2>
                <div class="dashboard-number">{{ totalRecords }}</div>
                <p>Staff-managed records</p>
                <a href="{{ path('app_admin_records') }}" class="dashboard-button">MANAGE RECORDS</a>
            </div>

            <div class="dashboard-card">

                <h2>Messages</h2>

                <div class="dashboard-number">
                    {{ totalMessages }}
                </div>

                <p>Contact messages</p>

                <a href="{{ path('app_admin_messages') }}" class="dashboard-button">
                    VIEW MESSAGES
                </a>

            </div>

            <div class="dashboard-card">

                <h2>Service Requests</h2>

                <div class="dashboard-number">
                    {{ totalRequests }}
                </div>

                <p>Service requests submitted by users. {{ pendingRequests }} currently pending.</p>

                <a href="{{ path('app_admin_service_requests') }}" class="dashboard-button">
                    VIEW REQUESTS
                </a>

            </div>

        </div>

        <section class="dashboard-report-grid" aria-label="System activity summaries">
            <article class="dashboard-card">
                <h2>Requests by status</h2>
                <ul class="dashboard-status-list">
                    {% for status, count in requestStatusCounts %}
                        <li><span>{{ status }}</span><strong>{{ count }}</strong></li>
                    {% endfor %}
                </ul>
            </article>
            <article class="dashboard-card">
                <h2>Work records by status</h2>
                <ul class="dashboard-status-list">
                    {% for status, count in recordStatusCounts %}
                        <li><span>{{ status }}</span><strong>{{ count }}</strong></li>
                    {% endfor %}
                </ul>
            </article>
        </section>

        <section class="dashboard-report-grid" aria-label="Recent activity">
            <article class="dashboard-card">
                <h2>Recent service requests</h2>
                <div class="table-container">
                    <table class="admin-table">
                        <thead><tr><th scope="col">Customer</th><th scope="col">Service</th><th scope="col">Status</th><th scope="col">Submitted</th><th scope="col">Details</th></tr></thead>
                        <tbody>
                        {% for request in recentRequests %}
                            <tr>
                                <td>{{ request.user.username }}</td>
                                <td>{{ request.service }}</td>
                                <td>{{ request.status }}</td>
                                <td>{{ request.createdAt|date('Y-m-d H:i') }}</td>
                                <td><a class="edit-button" href="{{ path('app_admin_service_request_show', {id: request.id}) }}">VIEW</a></td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5">No service requests yet.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </article>
            <article class="dashboard-card">
                <h2>Recent contact messages</h2>
                <div class="table-container">
                    <table class="admin-table">
                        <thead><tr><th scope="col">From</th><th scope="col">Received</th><th scope="col">Message</th><th scope="col">Details</th></tr></thead>
                        <tbody>
                        {% for message in recentMessages %}
                            <tr>
                                <td>{{ message.name }}</td>
                                <td>{{ message.createdAt|date('Y-m-d H:i') }}</td>
                                <td>{{ message.message|slice(0, 80) }}{% if message.message|length > 80 %}...{% endif %}</td>
                                <td><a class="edit-button" href="{{ path('app_admin_message_show', {id: message.id}) }}">VIEW</a></td>
                            </tr>
                        {% else %}
                            <tr><td colspan="4">No contact messages yet.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </article>
        </section>

    </main>

</body>
</html>
