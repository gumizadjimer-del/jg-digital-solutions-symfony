<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Request Details</title><link rel="stylesheet" href="{{ asset('CSS/styleA.css') }}"></head><body class="admin-page"><header class="admin-header"><div class="admin-header-content"><a class="admin-logo" href="{{ path('app_home') }}" aria-label="JG Digital Solutions home"><img src="{{ asset('image/Asset 1.png') }}" alt="JG Digital Solutions"></a><nav class="admin-nav"><a href="{{ path('app_dashboard') }}">Dashboard</a><a href="{{ path('app_service_request_new') }}">New Request</a><a href="{{ path('app_profile') }}">My Profile</a><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="logout-link">Logout</button></form></nav></div></header><main class="admin-container"><h1>{{ serviceRequest.service }}</h1><p>Request #{{ serviceRequest.id }} | {{ serviceRequest.createdAt|date('F d, Y') }}</p>{% for message in app.flashes('success') %}<div class="form-success">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="form-error">{{ message }}</div>{% endfor %}<section class="request-card"><p><strong>Status:</strong> {{ serviceRequest.status }}</p><p>{{ serviceRequest.description }}</p>{% if serviceRequest.adminNote %}<div class="note"><strong>Admin note</strong><p>{{ serviceRequest.adminNote }}</p></div>{% endif %}{% if serviceRequest.status == 'Pending' %}<form method="post" action="{{ path('app_service_request_cancel', {id: serviceRequest.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('cancel_request_' ~ serviceRequest.id) }}"><button class="delete-button">Cancel request</button></form>{% endif %}</section><a class="back-button" href="{{ path('app_dashboard') }}">Back to dashboard</a></main></body></html>