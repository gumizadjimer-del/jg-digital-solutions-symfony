<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Work Records | JG Digital Solutions</title>
    <link rel="stylesheet" href="{{ asset('CSS/styleA.css') }}">
</head>
<body class="admin-page">
<header class="admin-header"><div class="admin-header-content">
    <a class="admin-logo" href="{{ path('app_home') }}" aria-label="JG Digital Solutions home"><img src="{{ asset('image/Asset 1.png') }}" alt="JG Digital Solutions"></a>
    <nav class="admin-nav">
        <a href="{{ path('app_staff_dashboard') }}">Dashboard</a>
        <a href="{{ path('app_staff_records') }}">My Records</a>
        <a href="{{ path('app_staff_record_new') }}">Create Record</a>
        <a href="{{ path('app_profile') }}">My Profile</a>
        <form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="logout-link" type="submit">Logout</button></form>
    </nav>
</div></header>
<main class="admin-container">
    <div class="admin-heading"><h1>My Work Records</h1><p>Only records created by your account appear here.</p><a class="auth-button" href="{{ path('app_staff_record_new') }}">CREATE RECORD</a></div>
    {% for message in app.flashes('success') %}<div class="form-success" role="status">{{ message }}</div>{% endfor %}
    <form class="record-filter-form" method="get" action="{{ path('app_staff_records') }}">
        <div class="form-group"><label for="q">Search title or description</label><input id="q" name="q" type="search" maxlength="100" value="{{ search }}"></div>
        <div class="form-group"><label for="status">Status</label><select id="status" name="status"><option value="">All statuses</option>{% for status in statuses %}<option value="{{ status }}" {{ selectedStatus == status ? 'selected' : '' }}>{{ status }}</option>{% endfor %}</select></div>
        <button class="auth-button" type="submit">SEARCH</button>
        <a class="back-button" href="{{ path('app_staff_records') }}">CLEAR</a>
    </form>
    <p><a class="dashboard-button" href="{{ path('app_staff_records_export', {q: search, status: selectedStatus}) }}">DOWNLOAD MY FILTERED CSV</a></p>
    <p class="form-hint">Showing {{ firstResult }} to {{ lastResult }} of {{ totalRecords }} matching records.</p>
    <div class="table-container"><table class="admin-table">
        <thead><tr><th>Title</th><th>Description</th><th>Status</th><th>Created</th><th>Updated</th><th>Actions</th></tr></thead>
        <tbody>
        {% for record in records %}
            <tr>
                <td>{{ record.title }}</td><td>{{ record.description|slice(0, 120) }}{% if record.description|length > 120 %}...{% endif %}</td>
                <td>{{ record.status }}</td><td>{{ record.createdAt|date('Y-m-d') }}</td><td>{{ record.updatedAt|date('Y-m-d H:i') }}</td>
                <td class="action-buttons"><a class="edit-button" href="{{ path('app_staff_record_show', {id: record.id}) }}">VIEW</a><a class="edit-button" href="{{ path('app_staff_record_edit', {id: record.id}) }}">EDIT</a></td>
            </tr>
        {% else %}
            <tr><td colspan="6">You have not created any work records yet.</td></tr>
        {% endfor %}
        </tbody>
    </table></div>
    {% if totalPages > 1 %}
        <nav class="pagination" aria-label="My work record pages">
            {% if page > 1 %}
                <a href="{{ path('app_staff_records', {q: search, status: selectedStatus, page: page - 1}) }}">Previous</a>
            {% endif %}
            <span>Page {{ page }} of {{ totalPages }}</span>
            {% if page < totalPages %}
                <a href="{{ path('app_staff_records', {q: search, status: selectedStatus, page: page + 1}) }}">Next</a>
            {% endif %}
        </nav>
    {% endif %}
</main>
</body>
</html>
