<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ record.title }} | JG Digital Solutions</title>
    <link rel="stylesheet" href="{{ asset('CSS/styleA.css') }}">
</head>
<body class="admin-page">
<header class="admin-header"><div class="admin-header-content">
    <strong class="admin-logo">JG Digital Solutions</strong>
    <nav class="admin-nav">
        <a href="{{ path('app_staff_dashboard') }}">Dashboard</a>
        <a href="{{ path('app_staff_records') }}">My Records</a>
        <a href="{{ path('app_staff_record_new') }}">Create Record</a>
        <a href="{{ path('app_profile') }}">My Profile</a>
        <a href="{{ path('app_password_change') }}">Change Password</a>
        <form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="logout-link" type="submit">Logout</button></form>
    </nav>
</div></header>
<main class="admin-container">
    {% for message in app.flashes('success') %}<div class="form-success" role="status">{{ message }}</div>{% endfor %}
    <section class="request-card">
        <h1>{{ record.title }}</h1>
        <p><strong>Status:</strong> {{ record.status }}</p>
        <p><strong>Created:</strong> {{ record.createdAt|date('Y-m-d H:i') }}</p>
        <p><strong>Last updated:</strong> {{ record.updatedAt|date('Y-m-d H:i') }}</p>
        <p>{{ record.description|nl2br }}</p>
        <div class="action-buttons">
            <a class="edit-button" href="{{ path('app_staff_record_edit', {id: record.id}) }}">EDIT</a>
            <form method="post" action="{{ path('app_staff_record_delete', {id: record.id}) }}" onsubmit="return confirm('Delete this work record?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_staff_record_' ~ record.id) }}">
                <button class="delete-button" type="submit">DELETE</button>
            </form>
        </div>
    </section>
    <p class="auth-link"><a href="{{ path('app_staff_records') }}">Back to My Records</a></p>
</main>
</body>
</html>
